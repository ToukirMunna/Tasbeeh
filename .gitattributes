# Normalize line endings across platforms
* text=auto

# Force LF for source files
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.pro text eol=lf
*.md text eol=lf

# Force CRLF for Windows batch scripts
*.bat text eol=crlf

# Binary files
*.jks binary
*.keystore binary
*.png binary
*.jpg binary
*.webp binary
