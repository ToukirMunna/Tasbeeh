    <string name="adhkar_as_alukal_jannah">আল্লাহুম্মা ইন্নি আসআলুকাল জান্নাহ</string>
    <string name="adhkar_as_alukal_jannah_trans">হে আল্লাহ, আমি আপনার কাছে জান্নাত প্রার্থনা করছি</string>
    <string name="adhkar_as_alukal_jannah_virtue">কোনো ব্যক্তি ৩ বার জান্নাত চাইলে জান্নাত স্বয়ং আল্লাহর কাছে ওই ব্যক্তির জন্য সুপারিশ করে।</string>

