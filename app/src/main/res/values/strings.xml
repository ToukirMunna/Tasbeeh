    <!-- Adhkar Library Items -->
    <string name="adhkar_subhanallah">SubhanAllah</string>
    <string name="adhkar_subhanallah_trans">Glory be to Allah</string>
    <string name="adhkar_subhanallah_virtue">A tree is planted for the reciter in Paradise.</string>
    
    <string name="adhkar_alhamdulillah">Alhamdulillah</string>
    <string name="adhkar_alhamdulillah_trans">All praise is due to Allah</string>
    <string name="adhkar_alhamdulillah_virtue">It fills the scales of good deeds.</string>
    
    <string name="adhkar_allahuakbar">Allahu Akbar</string>
    <string name="adhkar_allahuakbar_trans">Allah is the Greatest</string>
    <string name="adhkar_allahuakbar_virtue">Fills the space between the heavens and the earth with rewards.</string>
    
    <string name="adhkar_lailahaillallah">La Ilaha Illallah</string>
    <string name="adhkar_lailahaillallah_trans">There is no god but Allah</string>
    <string name="adhkar_lailahaillallah_virtue">The best form of remembrance (Dhikr).</string>
    
    <string name="adhkar_astaghfirullah">Astaghfirullah</string>
    <string name="adhkar_astaghfirullah_trans">I seek forgiveness from Allah</string>
    <string name="adhkar_astaghfirullah_virtue">Removes anxiety and opens doors to provision.</string>
    
    <string name="adhkar_subhanallah_bihamdihi">SubhanAllahi wa bihamdihi</string>
    <string name="adhkar_subhanallah_bihamdihi_trans">Glory be to Allah and His is the praise</string>
    <string name="adhkar_subhanallah_bihamdihi_virtue">Whoever says this 100 times a day, their sins are forgiven even if they are as much as the foam of the sea.</string>
    
    <string name="adhkar_subhanallah_azeem">SubhanAllahil Azeem</string>
    <string name="adhkar_subhanallah_azeem_trans">Glory be to Allah, the Magnificent</string>
    <string name="adhkar_subhanallah_azeem_virtue">One of the two phrases that are light on the tongue but heavy on the scale.</string>
    
    <string name="adhkar_lahawla">La hawla wa la quwwata illa billah</string>
    <string name="adhkar_lahawla_trans">There is no power and no strength except with Allah</string>
    <string name="adhkar_lahawla_virtue">A treasure from the treasures of Paradise.</string>
    
    <string name="adhkar_four_phrases">The Four Phrases</string>
    <string name="adhkar_four_phrases_trans">SubhanAllah, wal-hamdulillah, wa la ilaha illallah, wallahu akbar</string>
    <string name="adhkar_four_phrases_virtue">The most beloved words to Allah.</string>

    <string name="adhkar_hasbunallah">HasbunAllahu wa ni\'mal wakil</string>
    <string name="adhkar_hasbunallah_trans">Sufficient for us is Allah, and [He is] the best Disposer of affairs</string>
    <string name="adhkar_hasbunallah_virtue">Protection against fear and harm.</string>

    <string name="adhkar_ayatul">Ayatul Kursi</string>
    <string name="adhkar_ayatul_trans">Verse of the Throne (2:255)</string>
    <string name="adhkar_ayatul_virtue">Greatest verse in the Quran; protection from Shaytan.</string>

    <string name="adhkar_malikil_quddus">Subhanal Malikil Quddus</string>
    <string name="adhkar_malikil_quddus_trans">Glory be to the Sovereign, the Most Holy</string>
    <string name="adhkar_malikil_quddus_virtue">Recited by the Prophet (ﷺ) three times after the Witr prayer to conclude the night\'s worship with praise.</string>

    <string name="adhkar_dhul_jalali">Ya Dhul Jalali wal Ikram</string>
    <string name="adhkar_dhul_jalali_trans">O Possessor of Majesty and Honor</string>
    <string name="adhkar_dhul_jalali_virtue">The Prophet (ﷺ) said, \"Persist (in calling upon Allah) with Ya Dhul-Jalali wal-Ikram.\" It is a powerful way to start any Dua.</string>

    <string name="adhkar_ajirni_nar">Allahumma Ajirni minan Nar</string>
    <string name="adhkar_ajirni_nar_trans">O Allah, protect me from the Fire</string>
    <string name="adhkar_ajirni_nar_virtue">Reciting this 7 times after Fajr and Maghrib prayer ensures protection from Hellfire if one dies that day/night.</string>

    <string name="adhkar_as_alukal_jannah">Allahumma inni as-alukal Jannah</string>
    <string name="adhkar_as_alukal_jannah_trans">O Allah, I ask You for Paradise</string>
    <string name="adhkar_as_alukal_jannah_virtue">If a person asks Allah for Paradise three times, Paradise itself says: \"O Allah, admit him into Paradise.\"</string>

    <string name="adhkar_rabbighfir_li">Rabbighfir li</string>
    <string name="adhkar_rabbighfir_li_trans">My Lord, forgive me</string>
    <string name="adhkar_rabbighfir_li_virtue">A very short yet heavy Istighfar recited between the two prostrations (Sajdah) in prayer.</string>

